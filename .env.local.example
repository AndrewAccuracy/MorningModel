# Copy this file to .env.local and fill in the values.
# Do not commit .env.local.

# Fill in ONE provider key. Leave the others empty.
# If more than one key is filled, set BETTER_MORNING_LLM_PROVIDER below.
BETTER_MORNING_OPENAI_API_KEY=""
BETTER_MORNING_DEEPSEEK_API_KEY=""
BETTER_MORNING_GEMINI_API_KEY=""

# auto, openai, deepseek, or gemini
BETTER_MORNING_LLM_PROVIDER="auto"

# Output language for all digest summaries and the one-line take.
# Overrides the output_language value in config.toml without editing tracked files.
# Examples: "English", "Chinese", "Japanese", "Spanish", "French"
# Leave empty to use the value in config.toml (default: Chinese).
BETTER_MORNING_OUTPUT_LANGUAGE=""

# Optional manual model override. Leave empty for provider defaults.
BETTER_MORNING_REASONER_MODEL=""
BETTER_MORNING_LIGHT_MODEL=""
BETTER_MORNING_FILTER_MODEL=""

# ── Email / SMTP credentials ──────────────────────────────────────────────────
#
# Set email_provider in config.toml to one of the supported providers, then
# fill in the matching credentials below.  Supported providers and how to get
# the password / authorization code for each:
#
#   gmail    → App Password (2FA required)
#              https://myaccount.google.com/apppasswords
#
#   outlook  → App Password (if MFA is on) or regular password
#              https://account.microsoft.com/security
#
#   icloud   → App-Specific Password
#              https://appleid.apple.com → Sign-In & Security → App-Specific Passwords
#
#   yahoo    → App Password
#              https://login.yahoo.com/account/security
#
#   zoho     → Regular password or App Password
#              https://accounts.zoho.com/home#security
#
#   qq       → Authorization code (授权码) — NOT your QQ password
#              QQ Mail → Settings → Account → Enable SMTP → Generate code
#
#   163/126  → Authorization code (客户端授权密码)
#              163/126 Mail → Settings → POP3/SMTP/IMAP → Enable → Generate code
#
#   custom   → Set smtp_server and smtp_port manually in config.toml
#
# The username is typically your full email address (e.g. you@gmail.com).
BETTER_MORNING_SMTP_USERNAME="you@example.com"
BETTER_MORNING_SMTP_PASSWORD="your-app-password-or-authorization-code"

# Recipient(s) — one address or comma-separated list.
BETTER_MORNING_RECIPIENT_EMAIL="you@example.com,another@example.com"

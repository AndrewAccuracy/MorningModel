# Copy this file to .env.local and fill in the values.
# Do not commit .env.local.

# Fill in ONE provider key. Leave the others empty.
# If more than one key is filled, set BETTER_MORNING_LLM_PROVIDER below.
BETTER_MORNING_OPENAI_API_KEY=""
BETTER_MORNING_DEEPSEEK_API_KEY=""
BETTER_MORNING_GEMINI_API_KEY=""

# auto, openai, deepseek, or gemini
BETTER_MORNING_LLM_PROVIDER="auto"

# Optional manual model override. Leave empty for provider defaults.
BETTER_MORNING_REASONER_MODEL=""
BETTER_MORNING_LIGHT_MODEL=""
BETTER_MORNING_FILTER_MODEL=""

# Gmail address used as the sender.
BETTER_MORNING_SMTP_USERNAME="yourname@gmail.com"

# Gmail App Password (NOT your regular Gmail password).
# Steps to generate one:
#   1. Enable 2-Step Verification at https://myaccount.google.com/security
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create a new app password (name it e.g. "better-morning")
#   4. Paste the 16-character code below (spaces are optional)
BETTER_MORNING_SMTP_PASSWORD="xxxx xxxx xxxx xxxx"

# You can use one address or multiple addresses separated by commas.
BETTER_MORNING_RECIPIENT_EMAIL="yourname@gmail.com,another@example.com"
